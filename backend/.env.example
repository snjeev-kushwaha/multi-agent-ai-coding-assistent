# Copy this file to .env and fill in real values before running.
# NEVER commit a real .env file -- in production, use a secrets manager
# (AWS Secrets Manager / Vault / Doppler) instead of a file on disk.

APP_NAME=AI Coding Assistant
ENV=development
DEBUG=true

# Generate a strong random value for production, e.g.: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173"]

# Local dev default (SQLite). For production use Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/coder_buddy
DATABASE_URL=sqlite+aiosqlite:///./coder_buddy.db

# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL_PLANNER=llama-3.1-8b-instant
GROQ_MODEL_ARCHITECT=llama-3.1-8b-instant
GROQ_MODEL_CODER=llama-3.3-70b-versatile

RATE_LIMIT_JOBS_PER_HOUR=10
RATE_LIMIT_REQUESTS_PER_MINUTE=60

MAX_FILES_PER_PROJECT=25
MAX_RETRIES_PER_FILE=2
MAX_CODER_TOOL_STEPS=12
JOB_TIMEOUT_SECONDS=900

OUTPUT_DIR=./generated_projects
ARTIFACT_EXPIRY_DAYS=7

SANDBOX_ENABLED=true
SANDBOX_CPU_LIMIT=1
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_NETWORK=none
